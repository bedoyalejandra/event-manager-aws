# ===========================================
# AWS CREDENTIALS (Requeridas)
# ===========================================
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=tu-secret-key-aqui
AWS_DEFAULT_REGION=us-east-1

# ===========================================
# CONFIGURACIÓN DE DESPLIEGUE (Requeridas)
# ===========================================
STACK_NAME=event-manager
ENVIRONMENT=dev
S3_LAMBDA_BUCKET=event-manager-lambda-code

# ===========================================
# BASE DE DATOS (Solo username - password automática)
# ===========================================
DB_USERNAME=event_admin
# DB_PASSWORD no es necesaria - se genera automáticamente en Secrets Manager

# ===========================================
# DESARROLLO LOCAL (Opcionales)
# ===========================================
# Estas variables solo se necesitan si ejecutas funciones Lambda localmente
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=EventManagerDB

# ===========================================
# CONFIGURACIÓN AVANZADA (Opcionales)
# ===========================================
# AWS_ACCOUNT_ID=123456789012
# AWS_PROFILE=default
# LOG_LEVEL=info

# ===========================================
# NOTAS IMPORTANTES:
# ===========================================
# 1. Copia este archivo como .env para desarrollo local
# 2. NUNCA subas el archivo .env al repositorio (está en .gitignore)
# 3. Para Bitbucket, configura estas variables en Repository Settings > Pipelines > Repository variables
# 4. Las variables marcadas como "secured" en Bitbucket: AWS_SECRET_ACCESS_KEY
# 5. DB_PASSWORD se genera automáticamente en AWS Secrets Manager
